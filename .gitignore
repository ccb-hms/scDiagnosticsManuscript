# ===================================================================
# .gitignore for scDiagnostics Manuscript R/Python Analysis
# ===================================================================

# -------------------------------------------------------------------
# General Development & IDE Files
# -------------------------------------------------------------------

.vscode/
.Rproj.user/
.DS_Store
Thumbs.db
*~

# -------------------------------------------------------------------
# R-Specific Files
# -------------------------------------------------------------------

.Rhistory
.RData

# -------------------------------------------------------------------
# Python-Specific Files
# -------------------------------------------------------------------

__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
venv/
.venv/
env/
.env/
celltypist_env/

# -------------------------------------------------------------------
# Project-Specific Generated Output & Data
# -------------------------------------------------------------------

# Ignore shell scripts (large jobs)
*.sh

# Logs from batch jobs
logs/

# Ignore data subdirectories (but keep download script)
data/covid/
data/merfish/

# Generated figures
figures/**/*
!figures/.gitkeep

# Generated results
results/**/*
!results/.gitkeep

# Python environment files
environment-*.yml

# Quarto rendered output
website/_site/
website/.quarto/
docs/