# ===================================================================
# .gitignore for scDiagnostics Manuscript R/Python Analysis
# ===================================================================

# -------------------------------------------------------------------
# General Development & IDE Files
# -------------------------------------------------------------------

# IDE-specific settings folders
.vscode/
.Rproj.user/

# Operating System files
.DS_Store  # macOS
Thumbs.db  # Windows

# Temporary backup files
*~


# -------------------------------------------------------------------
# R-Specific Files
# -------------------------------------------------------------------

# R session history and saved workspace
.Rhistory
.RData


# -------------------------------------------------------------------
# Python-Specific Files
# -------------------------------------------------------------------

# Compiled Python files
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/

# Python virtual environments (e.g., created by venv or conda)
venv/
.venv/
env/
.env/
celltypist_env/

# Conda environment definition files
*.yml


# -------------------------------------------------------------------
# Project-Specific Generated Output & Data
# -------------------------------------------------------------------

# Ignore all shell scripts
*.sh

# Directory for logs from batch jobs
logs/

# Directory for large data files (raw, intermediate, final)
data/

# Directory for generated figures and plots
figures/

# Directory for other analysis results (tables, etc.)
results/